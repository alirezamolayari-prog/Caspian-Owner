[
  { "id": "m-1", "request_id": "r-124", "author": { "kind": "staff", "name_fa": "امیر رحیمی" }, "text": "سلام. لامپ‌های راهروی همکف کنار پلاک ۶۸ چند تا سوخته‌اند.", "sent_at": "2026-10-12T11:51:00+03:30" },
  { "id": "m-2", "request_id": "r-124", "author": { "kind": "owner", "name_fa": "علیرضا", "is_me": true }, "text": "سلام. چند تا سوخته؟ ۲۴ تا زیاد به نظر می‌رسد.", "sent_at": "2026-10-12T11:52:00+03:30" },
  { "id": "m-3", "request_id": "r-124", "author": { "kind": "staff", "name_fa": "امیر رحیمی" }, "text": "۹ تا سوخته. بقیه هم کم‌نور شده‌اند و رنگشان با لامپ‌های نو فرق دارد.", "sent_at": "2026-10-12T11:53:00+03:30" },
  { "id": "m-4", "request_id": "r-124", "author": { "kind": "staff", "name_fa": "امیر رحیمی" }, "text": "اگر همه را یک‌جا عوض کنیم، دیگر لازم نیست هر هفته داربست ببریم.", "sent_at": "2026-10-12T11:53:30+03:30" },
  { "id": "m-5", "request_id": "r-124", "author": { "kind": "owner", "name_fa": "علیرضا", "is_me": true }, "text": "لامپ‌های قبلی که ماه پیش گرفتید کجا رفت؟", "sent_at": "2026-10-12T11:54:00+03:30" },
  { "id": "m-6", "request_id": "r-124", "author": { "kind": "staff", "name_fa": "امیر رحیمی" }, "text": "۸ تا برای همین راهرو و ۱۶ تا برای راهروی طبقه اول. حواله‌هایش در سیستم هست.", "sent_at": "2026-10-12T11:55:00+03:30" },
  { "id": "m-7", "request_id": "r-124", "author": { "kind": "staff", "name_fa": "امیر رحیمی" }, "text": "لامپ‌های سالمِ باز شده را هم تحویل انبار می‌دهیم.", "sent_at": "2026-10-12T11:55:30+03:30" },
  { "id": "m-8", "request_id": "r-124", "author": { "kind": "owner", "name_fa": "علیرضا", "is_me": true }, "text": "باشه. سالم‌ها را با شماره تحویل بدهید.", "sent_at": "2026-10-12T11:56:00+03:30" },
  { "id": "m-9", "request_id": "r-124", "author": { "kind": "staff", "name_fa": "امیر رحیمی" }, "text": "حتماً. ممنون.", "sent_at": "2026-10-12T11:57:00+03:30" },
  { "id": "m-10", "request_id": "r-123", "author": { "kind": "staff", "name_fa": "جواد صالحی" }, "text": "کلید تابلو آسانسور باری دو بار پریده. باید عوض شود.", "sent_at": "2026-10-12T11:16:00+03:30" },
  { "id": "m-11", "request_id": "r-123", "author": { "kind": "manager", "name_fa": "ناصر کریمی" }, "text": "کلیدها الان در شمارش هستند؛ بعد از شمارش تحویل می‌دهیم.", "sent_at": "2026-10-12T11:20:00+03:30" }
