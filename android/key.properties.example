# Copy this file to android/key.properties (git-ignored) and fill in the values.
# NEVER commit key.properties or the .jks file.
# Keep the .jks and these passwords in KeePassXC and in 3 backups.
storeFile=E:/keys/caspian-owner-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=caspian-owner
keyPassword=YOUR_KEY_PASSWORD
