<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parents are required by local_auth (crashes on Android 8 and
         below otherwise). DayNight follows the system theme. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Shown until Flutter draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it runs. -->
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
