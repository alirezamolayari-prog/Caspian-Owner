<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allows plain HTTP to a mock server on the local
     network. Release builds use src/main/res/xml (HTTPS only). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
